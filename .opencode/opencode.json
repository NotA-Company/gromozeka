{
    "$schema": "https://opencode.ai/config.json",

    "default_agent": "teamlead",
    "agent": {
        "build": {
            "model": "standard"
        },
        "plan": {
            "model": "smart"
        },
        "general": {
            "model": "standard"
        },
        "explore": {
            "model": "cheap"
        },
        "title": {
            "model": "cheap"
        },
        "summary": {
            "model": "cheap"
        }
    },

    "mcp": {
        "markdown-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "markdown-mcp",
                "serve"
            ],
            "environment": {
                "MARKDOWN_MCP_CONFIG": ".markdown-mcp.toml"
            },
            "timeout": 300000
        }
    },

    "lsp": {
    }

}
